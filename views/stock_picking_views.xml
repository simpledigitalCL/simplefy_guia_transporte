<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Los datos de transporte de la Res. 154 juntos, bajo el encabezado de la operación (entregas,
        traslados internos y cualquier otra que emita guía de despacho).

        Odoo los repartía entre el encabezado (salida y llegada) y la última pestaña (transporte y
        chofer). Se sacan de ahí y se presentan en una sola sección, fuera de los grupos del
        encabezado: así las personalizaciones de Studio que apuntan a un campo por su posición en
        el grupo (/group[2]/field[10]) siguen apuntando al mismo campo que antes de instalar la
        Res. 154.
    -->
    <record id="view_picking_form_guia_transporte" model="ir.ui.view">
        <field name="name">stock.picking.form.guia.transporte</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_cl_edi_stock_reform.view_picking_edi_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_cl_edi_departure_date']" position="replace"/>
            <xpath expr="//field[@name='l10n_cl_edi_arrival_date']" position="replace"/>
            <xpath expr="//page[@name='electronic_invoice']//field[@name='l10n_cl_edi_transport_id']" position="replace"/>
            <xpath expr="//page[@name='electronic_invoice']//field[@name='l10n_cl_edi_driver_id']" position="replace"/>

            <xpath expr="//field[@name='picking_properties']" position="before">
                <div name="l10n_cl_transporte" class="o_l10n_cl_transporte mt-3 mb-3"
                     invisible="country_code != 'CL' or (picking_type_code not in ('outgoing', 'internal') and not l10n_cl_dte_status)">
                    <field name="l10n_cl_transport_locked" invisible="1"/>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-1 mb-2">
                        <span class="o_form_label fs-5 fw-bold">Transporte</span>
                        <field name="l10n_cl_transport_mode" widget="radio" nolabel="1"
                               options="{'horizontal': true}" class="mb-0"
                               readonly="l10n_cl_transport_locked"/>
                    </div>
                    <div class="alert alert-warning py-2 mb-2" role="alert" invisible="not l10n_cl_transport_issues">
                        <field name="l10n_cl_transport_issues" nolabel="1" readonly="1"/>
                    </div>
                    <group name="l10n_cl_transporte_datos" class="mt-0">
                        <group name="l10n_cl_transporte_vehiculo" string="Vehículo y transportista">
                            <!-- Flota propia -->
                            <field name="l10n_cl_fleet_vehicle_id"
                                   invisible="l10n_cl_transport_mode != 'own'"
                                   options="{'no_create': True}"
                                   placeholder="Seleccione un vehículo de la Flota"
                                   readonly="l10n_cl_transport_locked"/>
                            <label for="l10n_cl_vehicle_load_weight" string="Carga"
                                   invisible="l10n_cl_transport_mode != 'own' or not l10n_cl_fleet_vehicle_id"/>
                            <div class="d-flex align-items-baseline gap-1"
                                 invisible="l10n_cl_transport_mode != 'own' or not l10n_cl_fleet_vehicle_id">
                                <field name="l10n_cl_vehicle_load_weight" nolabel="1" class="oe_inline w-auto"
                                       digits="[16, 0]"
                                       decoration-danger="l10n_cl_vehicle_weight_capacity and l10n_cl_vehicle_load_weight &gt; l10n_cl_vehicle_weight_capacity"/>
                                <span invisible="not l10n_cl_vehicle_weight_capacity">de</span>
                                <field name="l10n_cl_vehicle_weight_capacity" nolabel="1" class="oe_inline w-auto"
                                       digits="[16, 0]" invisible="not l10n_cl_vehicle_weight_capacity"/>
                                <span>kg asignados</span>
                            </div>
                            <field name="l10n_cl_own_transport_partner_id" string="Transportista"
                                   invisible="l10n_cl_transport_mode != 'own'"
                                   options="{'no_open': True}"/>
                            <!-- Transporte externo -->
                            <label for="l10n_cl_transport_partner_id" invisible="l10n_cl_transport_mode != 'external'"/>
                            <div class="o_row" invisible="l10n_cl_transport_mode != 'external'">
                                <field name="l10n_cl_transport_partner_id" nolabel="1"
                                       domain="[('category_id', '=', %(simplefy_guia_transporte.partner_category_carrier)d)]"
                                       options="{'no_create': True}"
                                       placeholder="Empresa que realiza el traslado"
                                       readonly="l10n_cl_transport_locked"/>
                                <button name="action_l10n_cl_new_carrier" type="object" string="Nuevo"
                                        icon="fa-plus" class="btn btn-link px-1 text-nowrap"
                                        invisible="l10n_cl_transport_locked"/>
                            </div>
                            <field name="l10n_cl_transport_vat" placeholder="76.086.428-5"
                                   invisible="l10n_cl_transport_mode == 'external' and not l10n_cl_transport_partner_id"
                                   readonly="l10n_cl_transport_locked or l10n_cl_transport_mode == 'own'"/>
                            <!-- Ambos -->
                            <field name="l10n_cl_license_plate" placeholder="ABCD12"
                                   readonly="l10n_cl_transport_locked"/>
                            <field name="l10n_cl_trailer_license_plate" placeholder="Sin carro"
                                   readonly="l10n_cl_transport_locked"/>
                        </group>
                        <group name="l10n_cl_transporte_chofer" string="Chofer y traslado">
                            <!-- Flota propia: un empleado -->
                            <field name="l10n_cl_driver_employee_id"
                                   invisible="l10n_cl_transport_mode != 'own'"
                                   options="{'no_create': True}"
                                   placeholder="Chofer de la empresa"
                                   readonly="l10n_cl_transport_locked"/>
                            <!-- Transporte externo: un contacto -->
                            <label for="l10n_cl_edi_driver_id" string="Chofer"
                                   invisible="l10n_cl_transport_mode != 'external'"/>
                            <div class="o_row" invisible="l10n_cl_transport_mode != 'external'">
                                <field name="l10n_cl_edi_driver_id" nolabel="1"
                                       domain="[('category_id', '=', %(simplefy_guia_transporte.partner_category_external_driver)d)]"
                                       options="{'no_create': True}"
                                       placeholder="Chofer del transportista"
                                       readonly="l10n_cl_transport_locked"/>
                                <button name="action_l10n_cl_new_driver" type="object" string="Nuevo"
                                        icon="fa-plus" class="btn btn-link px-1 text-nowrap"
                                        invisible="l10n_cl_transport_locked"/>
                            </div>
                            <field name="l10n_cl_driver_vat" placeholder="12.345.678-5"
                                   invisible="not l10n_cl_driver_employee_id and l10n_cl_transport_mode == 'own' or not l10n_cl_edi_driver_id and l10n_cl_transport_mode == 'external'"
                                   readonly="l10n_cl_transport_locked or l10n_cl_transport_mode == 'own'"/>
                            <field name="l10n_cl_crew_employee_ids" widget="many2many_tags"
                                   invisible="l10n_cl_transport_mode != 'own'"
                                   options="{'no_create': True}"
                                   placeholder="Peonetas"/>
                            <field name="l10n_cl_edi_departure_date"
                                   placeholder="Se registra al emitir la guía"
                                   readonly="l10n_cl_transport_locked"/>
                            <field name="l10n_cl_edi_arrival_date"
                                   placeholder="El día de la salida"
                                   readonly="l10n_cl_transport_locked"/>
                        </group>
                    </group>
                    <div class="text-muted small text-end">
                        Guía de Despacho: Transporte · by
                        <a href="https://simpledigital.cl" target="_blank" rel="noopener noreferrer">Simpledigital</a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

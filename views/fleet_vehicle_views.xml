<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_guia_transporte" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.guia.transporte</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_l10n_cl_view_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                    <field name="l10n_cl_picking_count" widget="statinfo" string="Entregas"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='future_driver_id']" position="after">
                <field name="l10n_cl_crew_employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="l10n_cl_weight_capacity" invisible="not category_id"/>
            </xpath>
        </field>
    </record>
</odoo>

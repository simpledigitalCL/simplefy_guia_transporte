<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        XML de la guía: patente, carro, transportista y chofer salen de los datos de transporte de
        la operación (flota propia o transporte externo), no del catálogo de transportes de la
        Res. 154. Con flota propia, el chofer es un empleado y su RUT, el número de
        identificación de su ficha.
    -->
    <template id="dte_subtemplate_transporte" inherit_id="l10n_cl_edi_stock_reform.dte_subtemplate">
        <xpath expr="//Patente" position="replace">
            <Patente t-out="format_length(picking.l10n_cl_license_plate, 8) or 'Sin Dato'"/>
        </xpath>
        <xpath expr="//PatenteCarro" position="replace">
            <PatenteCarro t-out="format_length(picking.l10n_cl_trailer_license_plate, 8) or 'Sin Dato'"/>
        </xpath>
        <xpath expr="//RUTTrans" position="replace">
            <RUTTrans t-out="format_vat(picking._l10n_cl_transportista().vat)"/>
        </xpath>
        <xpath expr="//Chofer" position="replace">
            <t t-set="chofer" t-value="picking._l10n_cl_chofer()"/>
            <Chofer>
                <RUTChofer t-out="format_vat(chofer['vat'])"/>
                <NombreChofer t-out="format_length(chofer['name'], 30) or 'Sin Dato'"/>
            </Chofer>
        </xpath>
    </template>

    <!--
        XML de la guía, receptor y montos:
        - Razón social y RUT del destinatario son los de la empresa, no los de la dirección de
          despacho: una dirección sin nombre dejaba la razón social vacía y el SII la rechazaba.
        - Un descuento nunca va como ítem (el SII rechaza precios negativos): va como descuento
          global, con el monto de la venta, para que la guía cuadre con la orden de venta.
    -->
    <template id="dte_subtemplate_receptor_descuento" inherit_id="l10n_cl_edi_stock.dte_subtemplate">
        <xpath expr="//RUTRecep" position="replace">
            <RUTRecep t-out="format_vat(picking.partner_id.commercial_partner_id.vat or picking.partner_id.vat)"/>
        </xpath>
        <xpath expr="//RznSocRecep" position="replace">
            <RznSocRecep t-out="format_length(picking.partner_id.commercial_partner_id.name or picking.partner_id.name, 100)"/>
        </xpath>
        <xpath expr="//t[@t-as='line']" position="attributes">
            <attribute name="t-foreach">picking._l10n_cl_dte_moves()</attribute>
        </xpath>
        <xpath expr="//t[@t-if='picking.sale_id.client_order_ref']" position="before">
            <t t-foreach="amounts.get('l10n_cl_global_discounts', [])" t-as="descuento_global">
                <DscRcgGlobal>
                    <NroLinDR t-out="descuento_global_index + 1"/>
                    <TpoMov>D</TpoMov>
                    <GlosaDR t-out="format_length(descuento_global['glosa'], 45)"/>
                    <TpoValor>$</TpoValor>
                    <ValorDR t-out="float_repr(descuento_global['amount'], 0)"/>
                    <IndExeDR t-if="descuento_global['exempt']">1</IndExeDR>
                </DscRcgGlobal>
            </t>
        </xpath>
    </template>

    <!--
        Guía impresa: los datos de transporte en un recuadro compacto de tres columnas. Los títulos
        van en el color principal de la empresa (Ajustes › Diseño del documento) y los datos en
        negro.
    -->
    <template id="stock_informations_transporte" inherit_id="l10n_cl_edi_stock_reform.stock_informations">
        <xpath expr="//div[@id='reform_info']" position="replace">
            <t t-set="sd_color" t-value="o.company_id.primary_color or '#212529'"/>
            <t t-set="sd_sin_dato">Sin dato</t>
            <t t-set="sd_chofer" t-value="o._l10n_cl_chofer()"/>
            <t t-set="sd_transportista" t-value="o._l10n_cl_transportista()"/>
            <t t-set="sd_propia" t-value="o._l10n_cl_is_own_fleet()"/>
            <div id="reform_info" class="mb-3" style="font-size: 0.8rem; line-height: 1.35;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; border: 1px solid #ced4da;">
                    <colgroup>
                        <col style="width: 11%;"/><col style="width: 22.3%;"/>
                        <col style="width: 11%;"/><col style="width: 22.3%;"/>
                        <col style="width: 11%;"/><col style="width: 22.4%;"/>
                    </colgroup>
                    <thead>
                        <tr>
                            <th colspan="6" t-attf-style="color: #{sd_color}; border-bottom: 1px solid #ced4da; padding: 3px 8px; font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase;">
                                Datos del transporte
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px 2px 8px; white-space: nowrap;">Transportista</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-out="sd_transportista.name or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">RUT</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-out="o._l10n_cl_rut_impreso(sd_transportista.vat) or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">Motivo</td>
                            <td style="color: #000; padding: 2px 8px 2px 4px;">
                                <span t-field="o.l10n_cl_delivery_guide_reason"/>
                            </td>
                        </tr>
                        <tr>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px 2px 8px; white-space: nowrap;">Vehículo</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-if="sd_propia and o.l10n_cl_fleet_vehicle_id"
                                      t-out="o.l10n_cl_fleet_vehicle_id.model_id.display_name or o.l10n_cl_fleet_vehicle_id.name"/>
                                <span t-elif="not sd_propia">Transporte externo</span>
                                <span t-else="" t-out="sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">Patente</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-out="o.l10n_cl_license_plate or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">Carro</td>
                            <td style="color: #000; padding: 2px 8px 2px 4px;">
                                <span t-out="o.l10n_cl_trailer_license_plate or sd_sin_dato"/>
                            </td>
                        </tr>
                        <tr>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px 2px 8px; white-space: nowrap;">Chofer</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-out="sd_chofer['name'] or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">RUT chofer</td>
                            <td style="color: #000; padding: 2px 4px;">
                                <span t-out="o._l10n_cl_rut_impreso(sd_chofer['vat']) or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px; white-space: nowrap;">Salida</td>
                            <td style="color: #000; padding: 2px 8px 2px 4px; white-space: nowrap;">
                                <span t-if="o.l10n_cl_edi_departure_date"
                                      t-out="o._l10n_cl_edi_get_departure_datetime().strftime('%d-%m-%Y %H:%M')"/>
                                <span t-else="" t-out="sd_sin_dato"/>
                            </td>
                        </tr>
                        <tr>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px 3px 8px; white-space: nowrap;">Destino</td>
                            <td colspan="3" style="color: #000; padding: 2px 4px 3px 4px;">
                                <span t-out="o._l10n_cl_get_comuna_recep() or sd_sin_dato"/>
                            </td>
                            <td t-attf-style="color: #{sd_color}; font-weight: bold; padding: 2px 4px 3px 4px; white-space: nowrap;">Llegada</td>
                            <td style="color: #000; padding: 2px 8px 3px 4px; white-space: nowrap;">
                                <span t-if="o.l10n_cl_edi_arrival_date"
                                      t-out="o.l10n_cl_edi_arrival_date.strftime('%d-%m-%Y')"/>
                                <span t-else="" t-out="sd_sin_dato"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>

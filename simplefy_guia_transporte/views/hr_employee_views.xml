<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_guia_transporte" model="ir.ui.view">
        <field name="name">hr.employee.form.guia.transporte</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="l10n_cl_is_driver"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_search_guia_transporte" model="ir.ui.view">
        <field name="name">hr.employee.search.guia.transporte</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Choferes" name="l10n_cl_choferes" domain="[('l10n_cl_is_driver', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
